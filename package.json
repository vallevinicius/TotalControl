{
  "name": "total-control",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:full": "concurrently -n WEB,API -c blue,green \"npm run dev\" \"npm --prefix server run dev\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "npm --prefix server test",
    "verificar": "tsc -b && vite build && npm --prefix server run typecheck && npm --prefix server test"
  },
  "dependencies": {
    "@tsparticles/engine": "^4.4.0",
    "@tsparticles/react": "^4.4.0",
    "@tsparticles/slim": "^4.4.0",
    "clsx": "^2.1.1",
    "framer-motion": "^13.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.3",
    "vite": "^5.3.4"
  }
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum PlanoSaaS {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

enum PapelUsuario {
  ADMIN
  GERENTE
  OPERADOR_CAIXA
}

enum TipoMovimentacao {
  ENTRADA
  SAIDA
}

enum FormaPagamento {
  PIX
  CARTAO_CREDITO
  CARTAO_DEBITO
  DINHEIRO
  BOLETO
  OUTRO
}

enum TipoLancamentoFinanceiro {
  RECEITA
  DESPESA
}

enum StatusCaixa {
  ABERTO
  FECHADO
}

/// A conta que assina o plano do SaaS. Pode ter uma ou várias lojas (Tenant)
/// — múltiplas lojas só é possível no plano ENTERPRISE (ver
/// server/src/config/planos.ts). Suspender/promover/expirar trial acontece
/// aqui, no nível da conta, e afeta todas as lojas dela de uma vez.
model Empresa {
  id            String    @id @default(uuid())
  nome          String
  planoAtual    PlanoSaaS @default(FREE)
  /// Data em que o teste grátis do plano FREE expira. Null para empresas
  /// criadas direto num plano pago. Ao expirar, o login é bloqueado até o
  /// admin promover a empresa para um plano pago (ver server/src/routes/auth.routes.ts).
  trialExpiraEm DateTime?
  /// Assinatura recorrente no Mercado Pago (ver server/src/lib/mercadopago.ts).
  /// NENHUMA (só teste/cortesia) | PENDENTE (checkout aberto) | ATIVA |
  /// CANCELADA (não renova; o acesso vai até `acessoAte`) | PAUSADA (cobrança falhou).
  assinaturaStatus String    @default("NENHUMA")
  /// Assinatura vigente no Mercado Pago (a que está sendo cobrada).
  mpAssinaturaId   String?
  /// Checkout aberto de um novo plano/upgrade; vira `mpAssinaturaId` quando autorizado
  /// (e a anterior é cancelada), sem perder o controle da vigente enquanto isso.
  mpCheckoutId     String?
  /// Plano escolhido no checkout ainda não confirmado (vira `planoAtual` quando o
  /// Mercado Pago autoriza a assinatura).
  planoPendente    PlanoSaaS?
  /// Fim do período já pago: até essa data o acesso continua, mesmo cancelada.
  acessoAte        DateTime?
  canceladaEm      DateTime?
  /// A conta principal recebe avisos por e-mail (teste acabando, pagamento recusado,
  /// estoque baixo, contas vencendo). Desligável na tela Empresa.
  avisosEmail      Boolean   @default(true)
  /// Empresa suspensa pela Total Software (ex: inadimplência, abuso) —
  /// ninguém de nenhuma loja dela consegue logar enquanto estiver false.
  ativo         Boolean   @default(true)
  criadoEm      DateTime  @default(now())

  lojas Tenant[]
  avisosEnviados AvisoEnviado[]
}

model Tenant {
  id                      String   @id @default(uuid())
  empresaId               String
  nomeFantasia            String
  razaoSocial             String?
  cnpj                    String   @unique
  /// Meios de contato da empresa (não é o e-mail de login de nenhum usuário).
  telefone                String?
  email                   String?
  site                    String?
  /// Dados fiscais e de endereço, coletados no cadastro da empresa.
  inscricaoEstadual       String?
  inscricaoMunicipal      String?
  regimeTributario        String?
  cep                     String?
  logradouro              String?
  numero                  String?
  complemento             String?
  bairro                  String?
  cidade                  String?
  uf                      String?
  logoDaLojaUrl           String   @db.MediumText
  corPrincipalDoTema      String
  corPrincipalHover       String?
  fusoHorario             String   @default("America/Sao_Paulo")
  moeda                   String   @default("BRL")
  exigirSenhaAoAbrirCaixa Boolean  @default(false)
  /// Loja desativada pelo dono da empresa: some do seletor de lojas e ninguém
  /// entra nela, mas os dados (vendas, estoque...) ficam preservados.
  ativo                   Boolean  @default(true)
  criadoEm                DateTime @default(now())

  empresa               Empresa                @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  usuarios              Usuario[]
  categorias            Categoria[]
  produtos              Produto[]
  clientes              Cliente[]
  transacoes            Transacao[]
  lancamentosFinanceiros LancamentoFinanceiro[]
  caixas                Caixa[]
  vendedores            Vendedor[]
  acessosExtras         AcessoLoja[]
  registrosAuditoria    RegistroAuditoria[]
  movimentacoesEstoque  MovimentacaoEstoque[]
  movimentosCaixa       MovimentoCaixa[]

  @@index([empresaId])
}

/// Concede a um Usuario acesso a uma loja além da sua loja de origem
/// (Usuario.tenantId) — usado pra dono de conta ENTERPRISE controlar mais
/// de uma loja com o mesmo login (ver server/src/routes/lojas.routes.ts).
model AcessoLoja {
  id        String   @id @default(uuid())
  usuarioId String
  tenantId  String
  criadoEm  DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, tenantId])
}

model Usuario {
  id        String       @id @default(uuid())
  tenantId  String
  nome      String
  email     String       @unique
  senhaHash String
  cpf       String?
  telefone  String?
  papel     PapelUsuario @default(OPERADOR_CAIXA)
  /// Telas que este usuário pode acessar (ex: ["dashboard","pdv"]).
  /// Ignorado para papel ADMIN, que sempre tem acesso total. `null` (contas
  /// antigas, antes desse campo existir) também é tratado como acesso total.
  permissoes Json?
  /// Ações finas que a pessoa pode fazer (ex: cancelar venda, sangria). `null` = o padrão do
  /// papel (server/src/config/acoes.ts); uma lista = exatamente essas. ADMIN sempre pode tudo.
  acoes      Json?
  /// Conta principal da loja, criada junto com o tenant no cadastro. Não
  /// pode ser desativada por ninguém — nem por outro Admin — pra loja nunca
  /// ficar sem um login que funcione.
  raiz      Boolean      @default(false)
  ativo     Boolean      @default(true)
  /// Sobe quando as sessões precisam cair na hora (senha redefinida, "sair de
  /// todos os dispositivos"): tokens com versão antiga deixam de valer.
  tokenVersion      Int       @default(0)
  /// Aceite dos Termos de Uso/Privacidade no cadastro (prova de consentimento, LGPD).
  aceiteTermosEm     DateTime?
  aceiteTermosVersao String?
  /// Cadastro self-service ainda sem o e-mail confirmado: não consegue entrar até clicar no link.
  /// (Contas criadas por um gestor ou pelo admin nascem confirmadas.)
  emailPendente Boolean    @default(false)
  criadoEm  DateTime     @default(now())

  sessoes                SessaoRefresh[]
  tokensVerificacao      TokenVerificacaoEmail[]
  tokensSenha            TokenSenha[]
  tenant                 Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transacoes             Transacao[]
  lancamentosFinanceiros LancamentoFinanceiro[]
  caixasAbertos          Caixa[]                @relation("CaixaAbertoPor")
  caixasFechados         Caixa[]                @relation("CaixaFechadoPor")
  acessosExtras          AcessoLoja[]
  registrosAuditoria     RegistroAuditoria[]

  @@index([tenantId])
}

model Categoria {
  id                     String  @id @default(uuid())
  tenantId               String
  nome                   String
  atributosCustomizados  Json?

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  produtos Produto[]

  @@index([tenantId])
}

model Produto {
  id                    String   @id @default(uuid())
  tenantId              String
  nome                  String
  sku                   String
  /// EAN/UPC lido pelo leitor no PDV (opcional; o SKU também é aceito na leitura).
  codigoBarras          String?
  categoriaId           String
  precoCusto            Decimal  @db.Decimal(12, 2)
  precoVenda            Decimal  @db.Decimal(12, 2)
  quantidadeEmEstoque   Int      @default(0)
  estoqueMinimo         Int      @default(0)
  atributosCustomizados Json?
  ativo                 Boolean  @default(true)
  criadoEm              DateTime @default(now())
  atualizadoEm          DateTime @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categoria      Categoria       @relation(fields: [categoriaId], references: [id])
  itensTransacao ItemTransacao[]
  movimentacoes  MovimentacaoEstoque[]

  @@unique([tenantId, sku])
  @@index([categoriaId])
  @@index([tenantId, codigoBarras])
}

model Cliente {
  id        String   @id @default(uuid())
  tenantId  String
  nome      String
  telefone  String?
  email     String?
  cpfCnpj   String?
  criadoEm  DateTime @default(now())

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transacoes Transacao[]

  @@index([tenantId])
}

/// Quem fez a venda no PDV, pra apurar comissão — não é necessariamente um
/// login do sistema (Usuario). Um Usuario pode vender sem estar cadastrado
/// aqui, e um Vendedor pode nunca ter feito login (ex: vendedor externo).
model Vendedor {
  id                 String   @id @default(uuid())
  tenantId           String
  nome               String
  /// % de comissão sobre o valor vendido (ex: 5 = 5%). 0 = sem comissão.
  comissaoPercentual Decimal  @default(0) @db.Decimal(5, 2)
  ativo              Boolean  @default(true)
  criadoEm           DateTime @default(now())

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vendas Transacao[]

  @@index([tenantId])
}

model Transacao {
  id             String            @id @default(uuid())
  tenantId       String
  tipo           TipoMovimentacao
  timestamp      DateTime          @default(now())
  valorTotal     Decimal           @db.Decimal(12, 2)
  desconto       Decimal           @default(0) @db.Decimal(12, 2)
  taxas          Decimal           @default(0) @db.Decimal(12, 2)
  formaPagamento FormaPagamento?
  /// Número de parcelas (só relevante para CARTAO_CREDITO).
  parcelas       Int               @default(1)
  usuarioId      String
  clienteId      String?
  /// Turno de caixa em que a venda foi feita (só para tipo SAIDA vindo do
  /// PDV — entradas de estoque não têm caixa).
  caixaId        String?
  /// Quem fez a venda, pra apuração de comissão (opcional).
  vendedorId     String?
  observacao     String?
  /// Venda cancelada: continua registrada (auditoria), mas não conta em nenhum total.
  cancelada         Boolean   @default(false)
  canceladaEm       DateTime?
  canceladaPorId    String?
  motivoCancelamento String?
  /// Identificador gerado pelo PDV no aparelho. Torna o envio da venda idempotente: reenviar a
  /// mesma venda (rede instável, fila offline) devolve a que já existe em vez de duplicar.
  idLocal    String?

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  usuario  Usuario         @relation(fields: [usuarioId], references: [id])
  cliente  Cliente?        @relation(fields: [clienteId], references: [id])
  caixa    Caixa?          @relation(fields: [caixaId], references: [id])
  vendedor Vendedor?       @relation(fields: [vendedorId], references: [id])
  itens    ItemTransacao[]
  pagamentos PagamentoVenda[]

  @@unique([tenantId, idLocal])
  @@index([tenantId, timestamp])
  @@index([vendedorId])
  @@index([caixaId])
}

model ItemTransacao {
  id                     String  @id @default(uuid())
  transacaoId            String
  productId              String
  nomeProdutoSnapshot    String
  quantidade             Int
  valorUnitarioPraticado Decimal @db.Decimal(12, 2)
  subtotal               Decimal @db.Decimal(12, 2)

  transacao Transacao @relation(fields: [transacaoId], references: [id], onDelete: Cascade)
  produto   Produto   @relation(fields: [productId], references: [id])

  @@index([transacaoId])
  @@index([productId])
}

model LancamentoFinanceiro {
  id         String                   @id @default(uuid())
  tenantId   String
  tipo       TipoLancamentoFinanceiro
  categoria  String
  descricao  String?
  valor      Decimal                  @db.Decimal(12, 2)
  /// Data em que o valor ENTRA no caixa/resultado: a do lançamento avulso, ou, numa
  /// conta a pagar/receber, o vencimento enquanto aberta e a data do pagamento depois de baixada.
  data       DateTime
  /// Preenchido nas contas a pagar/receber (lançamentos com vencimento). Conta aberta
  /// (sem `pagoEm`) não entra no resultado do período até ser baixada.
  vencimento DateTime?
  pagoEm     DateTime?
  usuarioId  String
  criadoEm   DateTime                 @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([tenantId, data])
  @@index([tenantId, vencimento])
}

/// Um turno de caixa: abre com um valor inicial em dinheiro, acumula as
/// vendas feitas no PDV enquanto está ABERTO, e fecha com a contagem final
/// informada pelo operador. Enquanto não houver um Caixa ABERTO, o PDV não
/// deixa vender. As vendas continuam todas visíveis pra sempre em
/// Relatórios — fechar o caixa só encerra o turno, não apaga nada.
model Caixa {
  id                      String      @id @default(uuid())
  tenantId                String
  status                  StatusCaixa @default(ABERTO)
  valorAbertura           Decimal     @db.Decimal(12, 2)
  abertoEm                DateTime    @default(now())
  abertoPorId             String
  valorContadoFechamento  Decimal?    @db.Decimal(12, 2)
  observacaoFechamento    String?
  fechadoEm               DateTime?
  fechadoPorId            String?

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  abertoPor  Usuario     @relation("CaixaAbertoPor", fields: [abertoPorId], references: [id])
  fechadoPor Usuario?    @relation("CaixaFechadoPor", fields: [fechadoPorId], references: [id])
  vendas     Transacao[]
  movimentos MovimentoCaixa[]

  @@index([tenantId, status])
}

/// Trilha de auditoria: ações sensíveis feitas por um login da loja (excluir
/// produto, desativar usuário, excluir lançamento financeiro etc.), pro dono
/// conseguir ver "quem fez o quê" sem precisar estar na loja o dia todo.
/// `usuarioNome` é uma cópia (snapshot) do nome no momento da ação — o
/// registro sobrevive mesmo se o usuário for excluído depois.
model RegistroAuditoria {
  id          String   @id @default(uuid())
  tenantId    String
  usuarioId   String?
  usuarioNome String
  acao        String
  detalhe     String?  @db.Text
  criadoEm    DateTime @default(now())

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([tenantId, criadoEm])
}

/// Conta interna da Total Software (dona do SaaS) — não pertence a nenhum
/// tenant, usada apenas pelo painel administrativo em /admin.
model AdminPlataforma {
  id        String   @id @default(uuid())
  nome      String
  email     String   @unique
  senhaHash String
  /// Segredo TOTP (app autenticador). Só vale depois de `totpAtivo`.
  totpSegredo String?
  totpAtivo   Boolean  @default(false)
  criadoEm  DateTime @default(now())
}

/// Sessão renovável do app: o token de acesso dura pouco e este registro (guardado
/// só como hash) permite renová-lo. Cada renovação gira o token; reutilizar um já
/// usado derruba todas as sessões da pessoa (sinal de roubo).
model SessaoRefresh {
  id        String    @id @default(uuid())
  usuarioId String
  tokenHash String    @unique
  expiraEm  DateTime
  revogadaEm DateTime?
  criadoEm  DateTime  @default(now())
  ip        String?
  userAgent String?   @db.VarChar(255)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
}

/// Link de redefinição de senha enviado por e-mail: uso único, vale 1 hora, guardado só como hash.
model TokenSenha {
  id        String    @id @default(uuid())
  usuarioId String
  tokenHash String    @unique
  expiraEm  DateTime
  usadoEm   DateTime?
  criadoEm  DateTime  @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
}

/// Link de confirmação do e-mail do cadastro: uso único, vale 24 horas, guardado só como hash.
model TokenVerificacaoEmail {
  id        String    @id @default(uuid())
  usuarioId String
  tokenHash String    @unique
  expiraEm  DateTime
  usadoEm   DateTime?
  criadoEm  DateTime  @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
}

enum TipoMovimentacaoEstoque {
  INICIAL
  ENTRADA
  VENDA
  ESTORNO
  AJUSTE
  /// Saída/entrada entre lojas da mesma empresa (plano com multiLoja).
  TRANSFERENCIA
}

/// Livro-razão do estoque: cada vez que o saldo de um produto muda, uma linha com
/// quanto mudou, o saldo depois e por quê. É o que responde "por que o estoque
/// está assim?". Começa a valer a partir da sua criação (não reconstrói o passado).
model MovimentacaoEstoque {
  id         String                  @id @default(uuid())
  tenantId   String
  produtoId  String
  tipo       TipoMovimentacaoEstoque
  /// Variação do saldo: positiva entra, negativa sai.
  quantidade Int
  saldoApos  Int
  motivo     String?
  usuarioId  String?
  /// Venda (Transacao) ou outro registro que originou o movimento.
  referenciaId String?
  criadoEm   DateTime                @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@index([produtoId, criadoEm])
  @@index([tenantId, criadoEm])
}

/// Controle de duplicidade dos avisos por e-mail: o mesmo aviso (tipo + chave) sai uma vez só por empresa.
model AvisoEnviado {
  id        String   @id @default(uuid())
  empresaId String
  tipo      String
  /// Identifica a "ocorrência" (ex: data do fim do teste, semana do ano).
  chave     String
  enviadoEm DateTime @default(now())

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@unique([empresaId, tipo, chave])
}

/// Uma forma de pagamento usada numa venda. Venda com um meio só tem uma linha; venda
/// dividida (ex: parte Pix, parte dinheiro) tem várias. `valor` é o da venda coberto por
/// essa forma (a taxa do cartão fica em Transacao.taxas).
model PagamentoVenda {
  id          String          @id @default(uuid())
  transacaoId String
  forma       FormaPagamento
  valor       Decimal         @db.Decimal(12, 2)
  parcelas    Int             @default(1)

  transacao Transacao @relation(fields: [transacaoId], references: [id], onDelete: Cascade)

  @@index([transacaoId])
}

enum TipoMovimentoCaixa {
  SANGRIA
  SUPRIMENTO
}

/// Dinheiro que sai (sangria: retirada pro cofre, pagamento de fornecedor) ou entra
/// (suprimento: troco colocado na gaveta) durante o turno do caixa.
model MovimentoCaixa {
  id        String             @id @default(uuid())
  tenantId  String
  caixaId   String
  tipo      TipoMovimentoCaixa
  valor     Decimal            @db.Decimal(12, 2)
  motivo    String
  usuarioId String
  criadoEm  DateTime           @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  caixa  Caixa  @relation(fields: [caixaId], references: [id], onDelete: Cascade)

  @@index([caixaId])
}

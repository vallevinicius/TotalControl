DATABASE_URL="mysql://USUARIO:SENHA@localhost:3306/saascontrole_db"
JWT_SECRET="troque-por-um-valor-aleatorio-longo"
PORT=4000

# Login do painel interno da Total Software (/admin) — separado do login das
# lojas. Ao trocar esses valores e reiniciar o servidor, a conta de admin é
# criada/atualizada automaticamente com essas credenciais.
ADMIN_EMAIL="----------"
ADMIN_SENHA="troque-por-uma-senha-forte"

# Assinaturas (Mercado Pago). Sem o token, a tela "Meu plano" mostra o pagamento
# como indisponível e o restante do sistema continua funcionando.
# Token da aplicação: https://www.mercadopago.com.br/developers/panel/app
MERCADOPAGO_ACCESS_TOKEN=""
# Chave secreta do webhook (painel do Mercado Pago > Webhooks). Com ela, as notificações
# sem a assinatura correta são recusadas.
MERCADOPAGO_WEBHOOK_SECRET=""
# Endereço do site (pra onde o Mercado Pago devolve a pessoa depois de pagar).
APP_URL="http://localhost:3099"
# Endereço PÚBLICO desta API, onde o Mercado Pago avisa pagamentos e cancelamentos
# (POST /api/assinatura/webhook). Em produção, algo como https://api.seudominio.com.br.
# Em desenvolvimento local pode ficar vazio: a tela consulta o Mercado Pago sozinha
# quando a pessoa volta do checkout.
API_PUBLIC_URL=""

# Segurança da API
# Origens extras autorizadas a chamar a API pelo navegador (além de APP_URL), separadas por vírgula.
CORS_ORIGINS=""
# Atrás de proxy/balanceador em produção, quantos saltos confiar pra ler o IP real
# do cliente (ex: 1). Sem isso o limite de tentativas vale para o proxy inteiro.
TRUST_PROXY=""

# Validade do token de acesso (a sessão longa vem do token de renovação, 30 dias).
ACCESS_TOKEN_TTL="30m"

# E-mail (recuperação de senha e avisos) por SMTP: serve para qualquer provedor
# (Resend, Amazon SES, Mailgun, SendGrid...). Sem SMTP_HOST o e-mail não é enviado:
# o conteúdo (com o link) aparece no log do servidor, o que basta em desenvolvimento.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Total Control <nao-responda@seudominio.com.br>"

# Monitoramento de erros (Sentry). Com o DSN preenchido, os erros 500 e exceções são enviados.
# Sem ele nada é enviado. Crie o projeto em sentry.io (tipo Node) e cole o DSN aqui.
SENTRY_DSN=""
# Formato dos logs: "json" (uma linha JSON por evento, para agregador) ou "texto". Em produção o padrão é json.
LOG_FORMATO=""

# Captcha do cadastro (Cloudflare Turnstile): chave SECRETA. Com ela definida, o cadastro exige o captcha
# (a chave pública vai em VITE_TURNSTILE_SITE_KEY no front). Vazio = captcha desligado (desenvolvimento).
# Para testar sem criar conta na Cloudflare, a Cloudflare publica chaves de teste:
#   site 1x00000000000000000000AA e secreta 1x0000000000000000000000000000000AA (sempre passa).
TURNSTILE_SECRET_KEY=

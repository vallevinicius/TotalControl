# Frontend (Vite) — opcional, o valor abaixo é o padrão de dev
VITE_API_URL=/api

# Endereço público do site (canonical, og:image e dados estruturados)
VITE_SITE_URL=http://localhost:3099

# Captcha do cadastro (Cloudflare Turnstile, gratuito): chave PÚBLICA do site.
# Crie em dash.cloudflare.com > Turnstile; a chave SECRETA vai no .env do servidor (TURNSTILE_SECRET_KEY).
# Vazio = sem captcha (desenvolvimento).
VITE_TURNSTILE_SITE_KEY=
